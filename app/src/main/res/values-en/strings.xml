<resources>
    <string name="app_name">HyperDuo</string>
    <string name="xposed_description">Merges Wi-Fi, mobile signal and battery into a single iPhone-Duo style trio glyph in the status bar.</string>

    <string name="group_appearance">Appearance</string>
    <string name="group_geometry">Geometry</string>
    <string name="group_colors">Colors</string>
    <string name="group_advanced">Advanced</string>

    <string name="master_title">Enable trio icon</string>
    <string name="master_summary">Master switch. Turn off to restore the stock battery and signal icons.</string>

    <string name="show_wifi_title">Show Wi-Fi arcs</string>
    <string name="show_wifi_summary">Draw the Wi-Fi arcs; the number of arcs follows the real signal level.</string>

    <string name="show_mobile_title">Show mobile dots</string>
    <string name="show_mobile_summary">Draw four level dots for mobile network signal strength.</string>

    <string name="show_value_title">Show battery number</string>
    <string name="show_value_summary">Show the battery percentage inside the ring; replaced by a bolt while charging.</string>

    <string name="show_bolt_title">Bolt while charging</string>
    <string name="show_bolt_summary">When off, the percentage stays visible while charging.</string>

    <string name="show_mobile_type_title">Show network type</string>
    <string name="show_mobile_type_summary">With no Wi-Fi, show 3G/4G/5G in the middle of the ring and move the battery number back to the top.</string>

    <string name="color_role_title">State colors</string>
    <string name="color_role_summary">Pick colors for low battery, charging and critical battery.</string>

    <string name="color_low_title">Low battery color</string>
    <string name="color_charging_title">Charging color</string>
    <string name="color_critical_title">Critical battery color</string>
    <string name="color_field_summary">Tap to pick a color</string>
    <string name="color_on_dark">Dark background</string>
    <string name="color_on_light">Light background</string>
    <string name="color_dialog_summary">Set the color used when the status bar sits on a dark or a light background.</string>
    <string name="color_reset">Reset to default</string>
    <string name="color_reset_summary">Restore the three state colors to their factory presets.</string>
    <string name="color_preview">Preview</string>

    <string name="low_threshold_title">Low battery threshold</string>
    <string name="low_threshold_summary">Switch to the low battery color below this percentage.</string>

    <string name="stroke_title">Ring stroke</string>
    <string name="stroke_summary">Stroke width of the battery ring.</string>

    <string name="arc_stroke_title">Arc stroke</string>
    <string name="arc_stroke_summary">Stroke width of the Wi-Fi arcs.</string>

    <string name="value_size_title">Number size</string>
    <string name="value_size_summary">Font size of the battery percentage.</string>

    <string name="value_weight_title">Number weight</string>
    <string name="value_weight_summary">Stroke weight of the battery number, 100 lightest to 900 heaviest.</string>

    <string name="type_size_title">Network type size</string>
    <string name="type_size_summary">Font size of the 3G/4G/5G label in the ring centre.</string>

    <string name="type_weight_title">Network type weight</string>
    <string name="type_weight_summary">Stroke weight of the network type, 100 lightest to 900 heaviest.</string>

