<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">HyperDuo</string>
    <string name="xposed_description">把状态栏的 Wi-Fi、移动信号与电池合并为一个仿 iPhone Duo 的三合一体图标。</string>

    <string name="group_appearance">外观</string>
    <string name="group_geometry">尺寸</string>
    <string name="group_colors">颜色</string>

    <string name="tab_general">常规</string>

    <string name="master_title">启用三合一图标</string>
    <string name="master_summary">总开关。关闭后恢复系统原本的电池与信号图标。</string>

    <string name="show_wifi_title">显示 Wi-Fi 弧</string>
    <string name="show_wifi_summary">在最外层绘制 Wi-Fi 弧线，弧数跟随实际信号强度。</string>

    <string name="show_mobile_title">显示移动信号点</string>
    <string name="show_mobile_summary">在底部绘制四个电平点表示移动网络信号强度。</string>

    <string name="show_value_title">显示电量数字</string>
    <string name="show_value_summary">在环内显示电量百分比；充电时改为闪电图标。</string>

    <string name="show_bolt_title">充电时显示闪电</string>
    <string name="show_bolt_summary">关闭后充电时仍显示电量数字。</string>

    <string name="show_mobile_type_title">显示网络类型</string>
    <string name="show_mobile_type_summary">无 Wi-Fi 时在圆环中间显示 3G/4G/5G 等网络类型，电量数字回到顶部。</string>

    <string name="swap_wifi_value_title">Wi-Fi 与数字换位</string>
    <string name="swap_wifi_value_summary">电量数字放大到圆环中间，Wi-Fi 弧缩到顶部缺口；充电时由大闪电占据圆心。</string>

    <string name="color_role_title">状态颜色</string>
    <string name="color_role_summary">分别为低电量、充电与危险电量指定颜色。</string>

    <string name="color_low_title">低电量颜色</string>
    <string name="color_charging_title">充电颜色</string>
    <string name="color_critical_title">危险电量颜色</string>
    <string name="color_field_summary">点按选择颜色</string>
    <string name="color_on_dark">深色背景</string>
    <string name="color_on_light">浅色背景</string>
    <string name="color_dialog_summary">分别设置状态栏为深色与浅色背景时使用的颜色。</string>
    <string name="color_reset">恢复默认</string>
    <string name="color_reset_summary">把三种状态颜色恢复为出厂预设。</string>
    <string name="color_preview">预览</string>

    <string name="low_threshold_title">低电量阈值</string>
    <string name="low_threshold_summary">电量低于该值时切换到低电量颜色。</string>

    <string name="stroke_title">环线粗细</string>
    <string name="stroke_summary">电池圆环的描边宽度。</string>

    <string name="arc_stroke_title">弧线粗细</string>
    <string name="arc_stroke_summary">Wi-Fi 弧线的描边宽度。</string>

    <string name="value_size_title">数字字号</string>
    <string name="value_size_summary">电量百分比文字的尺寸。</string>

    <string name="value_weight_title">数字字重</string>
    <string name="value_weight_summary">电量数字的笔画粗细，100 最细、900 最粗。</string>

    <string name="type_size_title">网络类型字号</string>
    <string name="type_size_summary">圆环中间 3G/4G/5G 等文字的大小。</string>

    <string name="type_weight_title">网络类型字重</string>
    <string name="type_weight_summary">网络类型的笔画粗细，100 最细、900 最粗。</string>

    <string name="track_alpha_title">底纹浓度</string>
    <string name="track_alpha_summary">未点亮部分的透明度。</string>

    <string name="debug_title">调试日志</string>
